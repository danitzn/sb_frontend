# Copia este archivo a .env.local y ajusta los valores.

# URL del backend (solo servidor). Ej: http://localhost:8000 o la URL de Vercel del backend
API_BASE_URL=http://localhost:8000

# Secreto de "Protection Bypass for Automation" del proyecto backend en Vercel
# (Settings → Deployment Protection). Solo servidor: NO usar prefijo NEXT_PUBLIC_.
VERCEL_PROTECTION_BYPASS=

# Modo de chat por defecto en el navegador: cloud | local
NEXT_PUBLIC_API_CHAT_PATH=cloud
